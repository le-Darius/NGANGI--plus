<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Mettez true une fois la charge de travail Android installée : dotnet workload install maui-android -->
    <NgangiAndroid Condition="'$(NgangiAndroid)' == ''">false</NgangiAndroid>

    <TargetFrameworks Condition="'$(NgangiAndroid)' == 'true'">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="'$(NgangiAndroid)' != 'true' And !$([MSBuild]::IsOSPlatform('windows'))">net10.0-android</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

    <OutputType>Exe</OutputType>
    <RootNamespace>Ngangi.App</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <ApplicationTitle>Ngangi+</ApplicationTitle>
    <ApplicationId>com.ngangi.app</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>

    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
    <SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
    <TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>

    <!-- DisplayAlert est marqué obsolète en .NET 10 mais fonctionne toujours -->
    <NoWarn>$(NoWarn);CS0618;XC0022;XC0025</NoWarn>
  </PropertyGroup>

  <!-- Windows : application non empaquetée, lancement direct avec dotnet run -->
  <PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
  </PropertyGroup>

  <ItemGroup>
    <!-- Icône adaptative : fond uni (Bg), avant-plan dans la zone sûre (emblème = 60 % du calque), couche monochrome
         pour les icônes thématiques d'Android 13+. Couleurs = Colors.xaml (Bg, Hero) ; vérifiées par tools/verify_palette.py -->
    <MauiIcon Include="Resources\AppIcon\appicon.svg"
              ForegroundFile="Resources\AppIcon\appiconfg.svg"
              MonochromeFile="Resources\AppIcon\appiconmono.svg"
              ForegroundScale="1"
              Color="#F3F8FA" />
    <MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#0B4A66" BaseSize="128,128" />

    <!-- Logos de l'application : SVG convertis à la taille voulue au moment de la compilation (pas de gros PNG) -->
    <MauiImage Include="Resources\Images\logo_ngangi.svg" BaseSize="48,48" />
    <MauiImage Include="Resources\Images\logo_ngangi_dark.svg" BaseSize="48,48" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ngangi.Core\Ngangi.Core.csproj" />
  </ItemGroup>

  <!-- Données de démonstration : embarquées uniquement en Debug. Une version Release ne les contient pas. -->
  <ItemGroup Condition="'$(Configuration)' == 'Debug'">
    <Compile Include="..\Ngangi.Tests\SeedData.cs" Link="Debug\SeedData.cs" />
  </ItemGroup>


	<!-- Windows non empaqueté (dotnet run) : DPAPI pour protéger la clé de chiffrement quand SecureStorage est indisponible -->
	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
	</ItemGroup>

</Project>
