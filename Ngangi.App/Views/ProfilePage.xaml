<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Ngangi.App.Views.ProfilePage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Ngangi.App"
             xmlns:c="clr-namespace:Ngangi.App.Controls"
             Title="{x:Static t:AppTexts.ProfileTitle}" SafeAreaEdges="All">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
            <c:IconButton Kind="Back" Command="{Binding BackCommand}" Description="{x:Static t:AppTexts.Back}" />

            <HorizontalStackLayout Spacing="10">
                <c:Icon Kind="Settings" Tone="Ok" />
                <Label Text="{x:Static t:AppTexts.ProfileTitle}" Style="{StaticResource Title}" VerticalOptions="Center"
                       SemanticProperties.HeadingLevel="Level1" />
            </HorizontalStackLayout>

            <!-- Compte -->
            <Label Text="{x:Static t:AppTexts.ProfileAccountSection}" Style="{StaticResource Eyebrow}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
                        <Border Style="{StaticResource Avatar}" WidthRequest="56" HeightRequest="56" VerticalOptions="Center"
                                AutomationProperties.IsInAccessibleTree="False">
                            <Label Text="{Binding Initials}" Style="{StaticResource AvatarLabel}" />
                        </Border>
                        <VerticalStackLayout Grid.Column="1" Spacing="2" VerticalOptions="Center">
                            <Label Text="{Binding FullName}" Style="{StaticResource Sub}" SemanticProperties.HeadingLevel="Level2" />
                            <Label Text="{Binding Role}" Style="{StaticResource Caption}" />
                        </VerticalStackLayout>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{x:Static t:AppTexts.ProfilePhoneLabel}" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Phone}" Style="{StaticResource Name}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{x:Static t:AppTexts.ProfileGroupLabel}" Style="{StaticResource Muted}" />
                        <Label Grid.Column="1" Text="{Binding Group}" Style="{StaticResource Name}" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Thème -->
            <Label Text="{x:Static t:AppTexts.ThemeSection}" Style="{StaticResource Eyebrow}" SemanticProperties.HeadingLevel="Level2" />
            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="10">
                    <Label Text="{x:Static t:AppTexts.ThemeTitle}" Style="{StaticResource Name}" />
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="8">
                        <c:ChoiceTile Grid.Column="0" Text="{x:Static t:AppTexts.ThemeAuto}" IsSelected="{Binding IsThemeAuto}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="auto" />
                        <c:ChoiceTile Grid.Column="1" Text="{x:Static t:AppTexts.ThemeLight}" IsSelected="{Binding IsThemeLight}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="light" />
                        <c:ChoiceTile Grid.Column="2" Text="{x:Static t:AppTexts.ThemeDark}" IsSelected="{Binding IsThemeDark}"
                                      Command="{Binding SetThemeCommand}" CommandParameter="dark" />
                    </Grid>
                    <Label Text="{x:Static t:AppTexts.ThemeAutoHint}" Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <!-- Données : sauvegarde -->
            <Label Text="{x:Static t:AppTexts.DataSection}" Style="{StaticResource Eyebrow}" SemanticProperties.HeadingLevel="Level2" />
            <c:SettingsRow Kind="Save" Title="{x:Static t:AppTexts.BackupTitle}" Caption="{x:Static t:AppTexts.BackupCaption}"
                           Command="{Binding BackupCommand}" />

            <!-- Informations : À propos, Confidentialité et Conditions -->
            <Label Text="{x:Static t:AppTexts.InfoSection}" Style="{StaticResource Eyebrow}" SemanticProperties.HeadingLevel="Level2" />
            <VerticalStackLayout Spacing="8">
                <c:SettingsRow Kind="Info" Title="{x:Static t:AppTexts.AboutTitle}" Caption="{x:Static t:AppTexts.AboutCaption}"
                               Command="{Binding AboutCommand}" />
                <c:SettingsRow Kind="Privacy" Title="{x:Static t:AppTexts.PrivacyTitle}" Caption="{x:Static t:AppTexts.PrivacyCaption}"
                               Badge="{x:Static t:AppTexts.ComingSoonBadge}" Command="{Binding PrivacyCommand}" />
                <c:SettingsRow Kind="Terms" Title="{x:Static t:AppTexts.TermsTitle}" Caption="{x:Static t:AppTexts.TermsCaption}"
                               Badge="{x:Static t:AppTexts.ComingSoonBadge}" Command="{Binding TermsCommand}" />
            </VerticalStackLayout>

            <!-- Déconnexion : explicite, avec confirmation -->
            <c:SettingsRow Kind="Logout" Title="{x:Static t:AppTexts.LogoutTitle}" Caption="{x:Static t:AppTexts.LogoutCaption}"
                           Command="{Binding LogoutCommand}" Margin="0,10,0,0" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
