<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="Ngangi.App.Views.FinesPage"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:t="clr-namespace:Ngangi.App"
             xmlns:c="clr-namespace:Ngangi.App.Controls"
             Title="Amendes" SafeAreaEdges="All">
    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,24" Spacing="14">
            <c:IconButton Kind="Back" Command="{Binding BackCommand}" Description="{x:Static t:AppTexts.Back}" />
            <Label Text="Amendes" Style="{StaticResource Title}" SemanticProperties.HeadingLevel="Level2" />

            <Border Style="{StaticResource Banner}">
                <VerticalStackLayout Spacing="2">
                    <Label Text="À encaisser" Style="{StaticResource BannerText}" />
                    <Label Text="{Binding Pending}" Style="{StaticResource BannerText}" FontSize="{StaticResource FontTitle}" FontAttributes="Bold" />
                    <Label Text="{Binding Paid}" Style="{StaticResource BannerText}" />
                </VerticalStackLayout>
            </Border>

            <Border Style="{StaticResource Card}">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Barème du groupe" Style="{StaticResource Sub}" SemanticProperties.HeadingLevel="Level2" />
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Cotisation en retard" />
                        <Label Grid.Column="1" Text="{Binding Scale1}" FontAttributes="Bold" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="Remboursement en retard" />
                        <Label Grid.Column="1" Text="{Binding Scale2}" FontAttributes="Bold" />
                    </Grid>
                    <Label Text="Ajoutée automatiquement dès le lendemain de la date limite." Style="{StaticResource Caption}" />
                </VerticalStackLayout>
            </Border>

            <Label Text="À encaisser" Style="{StaticResource Sub}" SemanticProperties.HeadingLevel="Level2" />
            <CollectionView ItemsSource="{Binding Fines}" ItemTemplate="{StaticResource RowTemplate}" SelectionMode="None" ItemsLayout="VerticalList" />

            <Border Style="{StaticResource Card}" IsVisible="{Binding HasNoFines}">
                <VerticalStackLayout Spacing="4" Padding="0,8">
                    <Label Text="Aucune amende" Style="{StaticResource Sub}" HorizontalTextAlignment="Center" SemanticProperties.HeadingLevel="Level2" />
                    <Label Text="Tout le monde est à jour pour le moment." Style="{StaticResource Caption}" HorizontalTextAlignment="Center" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
