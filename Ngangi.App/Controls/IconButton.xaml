<?xml version="1.0" encoding="utf-8" ?>
<!-- Bouton à icône seule, zone tactile de 48 × 48 dp. Un vrai Button transparent est posé sur l'icône : il donne
     le retour tactile, le focus clavier et le rôle « bouton » aux lecteurs d'écran. -->
<ContentView x:Class="Ngangi.App.Controls.IconButton"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Ngangi.App.Controls"
             HorizontalOptions="Start" VerticalOptions="Center">
    <Grid WidthRequest="48" HeightRequest="48">
        <c:Icon x:Name="Glyph" />
        <Button x:Name="Hit" BackgroundColor="{StaticResource Clear}" Padding="0" BorderWidth="0"
                WidthRequest="48" HeightRequest="48" CornerRadius="24" Clicked="OnClicked" />
    </Grid>
</ContentView>
