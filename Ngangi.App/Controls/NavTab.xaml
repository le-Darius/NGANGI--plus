<?xml version="1.0" encoding="utf-8" ?>
<!-- Un onglet de la barre du bas : icône + libellé. L'onglet choisi se reconnaît sans la couleur : barre en haut,
     pastille derrière l'icône (la forme change), en plus de la teinte. Zone tactile ≥ 48 dp : hauteur ≥ 64 dp, largeur = 1/5 de l'écran (64 dp à 320 dp). -->
<ContentView x:Class="Ngangi.App.Controls.NavTab"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Ngangi.App.Controls">
    <Grid RowDefinitions="3,*" RowSpacing="0" MinimumHeightRequest="64" MinimumWidthRequest="48">
        <BoxView x:Name="Marker" Grid.Row="0" HeightRequest="3" WidthRequest="32" CornerRadius="2" HorizontalOptions="Center"
                 Color="{AppThemeBinding Light={StaticResource Pri}, Dark={StaticResource PriD}}" IsVisible="False" />

        <VerticalStackLayout Grid.Row="1" Spacing="2" Padding="0,5,0,6">
            <Grid HorizontalOptions="Center" WidthRequest="56" HeightRequest="32">
                <Border x:Name="Pill" StrokeThickness="0" IsVisible="False"
                        BackgroundColor="{AppThemeBinding Light={StaticResource Tint}, Dark={StaticResource TintD}}">
                    <Border.StrokeShape><RoundRectangle CornerRadius="16" /></Border.StrokeShape>
                </Border>
                <c:Icon x:Name="Glyph" Tone="Muted" />
            </Grid>
            <Label x:Name="Caption" HorizontalTextAlignment="Center" LineBreakMode="TailTruncation" MaxLines="1" />
        </VerticalStackLayout>

        <Button x:Name="Hit" Grid.Row="0" Grid.RowSpan="2" BackgroundColor="{StaticResource Clear}" Padding="0" BorderWidth="0"
                CornerRadius="0" Clicked="OnClicked" />
    </Grid>
</ContentView>
