<?xml version="1.0" encoding="utf-8" ?>
<!-- Raccourci de l'accueil : icône + libellé dans une carte. Un Button transparent couvre la carte (retour tactile,
     rôle « bouton » pour les lecteurs d'écran). -->
<ContentView x:Class="Ngangi.App.Controls.ShortcutTile"
             xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:c="clr-namespace:Ngangi.App.Controls">
    <Grid>
        <Border Style="{StaticResource Card}" Padding="8,16">
            <VerticalStackLayout Spacing="8">
                <c:Icon x:Name="Glyph" Tone="Ok" />
                <Label x:Name="Caption" Style="{StaticResource NameSmall}" HorizontalTextAlignment="Center" />
            </VerticalStackLayout>
        </Border>
        <Button x:Name="Hit" BackgroundColor="{StaticResource Clear}" Padding="0" BorderWidth="0" CornerRadius="16" Clicked="OnClicked" />
    </Grid>
</ContentView>
